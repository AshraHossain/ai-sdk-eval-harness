{
  "name": "ai-sdk-eval-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "eval": "tsx evals/runner/cli.ts",
    "eval:ci": "tsx evals/runner/cli.ts --runs 5",
    "eval:baseline": "tsx evals/runner/cli.ts --runs 5 --update-baseline",
    "eval:calibrate": "tsx evals/calibration/calibrate.ts",
    "eval:gate-selftest": "tsx scripts/gate-selftest.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.81",
    "@ai-sdk/openai": "^4.0.95",
    "ai": "^7.0.142",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
