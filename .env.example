# Offline by default. Set EVAL_MODE=live and provide keys to hit real providers.
EVAL_MODE=mock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Bynara router (OpenAI-compatible). Use models like EVAL_MODEL=bynara:<model-id>
BYNARA_API_KEY=
BYNARA_BASE_URL=https://router.bynara.id/v1
# OpenRouter (OpenAI-compatible). Use models like EVAL_MODEL=openrouter:nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# provider:model
EVAL_MODEL=anthropic:claude-haiku-5-5
EVAL_JUDGE_MODEL=anthropic:claude-sonnet-5-5
