# mock (default, no keys, deterministic) | live (real providers)
EVAL_MODE=mock

# live mode only
EVAL_PROVIDER=anthropic            # anthropic | openai
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# EVAL_SUBJECT_MODEL=claude-haiku-4-5
# EVAL_JUDGE_MODEL=claude-sonnet-4-5

# Judge from a different provider family than the subject (reduces self-preference bias)
# EVAL_JUDGE_PROVIDER=openai

# Allow POST /api/eval in live mode (spends tokens). Always allowed in mock mode.
EVAL_API_ENABLED=false
EVAL_API_TOKEN=

# Default N for `npm run eval`
EVAL_RUNS=5
